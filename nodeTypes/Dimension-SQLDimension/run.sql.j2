{# == Node Type Name           : Dimension  == #}
{# == Node Type Description    : This node loads data into dimension table using options distinct and multi-source cte if specified == #}

{#
    ClickHouse has no MERGE, so each load only INSERTs the row set the MERGE would have applied. An "update"
    re-inserts the same key with a newer SYSTEM_UPDATE_DATE (SCD2 expiry re-inserts the old version with
    SYSTEM_CURRENT_FLAG = 'N').
    - ReplacingMergeTree (@engine or the package engine parameter): per ORDER BY key (business key + SYSTEM_VERSION + surrogate key)
      the row with the latest SYSTEM_UPDATE_DATE replaces the others at a background merge. Nothing is deleted;
      until the merge a plain SELECT can see the replaced copies, so the load and the column tests read with
      FINAL through SETTINGS final = 1 when readWithFinal is true.
    - MergeTree (the default) or any other engine: a DELETE removes the replaced copies after the insert.
#}

{# == Table engine from @engine — see set_table_engine() == #}
{{- set_table_engine(true) }}

{# == Validate: the materialization type must be table or view == #}
{{ validate_materialization_type() }}

{# == Materialization type from the node, normalised (case and spaces): table / view == #}
{%- set materializationType = get_materialization_type(node.materializationType) %}

{# == To run data quality tests before data insertion == #}
{{ run_tests('Before') }}

{%- if materializationType == 'table' %}

    {{ validate_dimension_requirements() }}

    {%- set hasBusinessKey = columns | selectattr("isBusinessKey") | list | length > 0 | default(false) %}
    {%- set hasSurrogateKey = columns | selectattr("isSurrogateKey") | list | length > 0 %}
    {%- set lastModifiedCount = columns | selectattr("lastModifiedTracking") | list | length %}
    {%- set changeTrackingCount = columns | selectattr("isChangeTracking") | list | length %}

    {%- set mergeStrategyExplicit = config.mergeStrategy is defined and config.mergeStrategy.parameters is defined and config.mergeStrategy.parameters | length > 0 %}
    {%- if mergeStrategyExplicit %}
        {# Matched case-insensitively; an unrecognised value is rejected by validate_dimension_requirements before any load runs. #}
        {%- set mergeStrategy = config.mergeStrategy.parameters[0] | string | trim | lower %}
    {%- else %}
        {# No @mergeStrategy given — always default to changeTracking, regardless of which tracking columns are present (must match validate_dimension_requirements). #}
        {%- set mergeStrategy = 'changetracking' %}
    {%- endif %}
    {%- set isLastModifiedStrategy = mergeStrategy == 'lastmodified' %}
    {%- set isChangeTrackingStrategy = mergeStrategy == 'changetracking' %}

    {# lastModified with a tracking column present — the no-column case is rejected by validate_dimension_requirements, and there'd be nothing to compare. #}
    {%- set lastModifiedComparison = isLastModifiedStrategy and lastModifiedCount > 0 %}
    {%- if lastModifiedComparison %}
        {%- set lastModifiedCol = columns | selectattr("lastModifiedTracking") | first %}
        {%- set lastModifiedColName = lastModifiedCol.name %}
    {%- endif %}
    {%- if hasBusinessKey %}
        {%- if lastModifiedComparison %}
            {# A bare @lastModifiedTracking (no scdType) comes through as `true`, not a mapping — guard for that and default scdType to 1. #}
            {%- set lastModifiedTrackingParams = lastModifiedCol.lastModifiedTracking.parameters if (lastModifiedCol.lastModifiedTracking is mapping and lastModifiedCol.lastModifiedTracking.parameters is defined) else [] %}
            {%- set scdType = lastModifiedTrackingParams[0] | default(1, true) | string %}
            {%- set type2Dimension = scdType == '2' %}
        {%- else %}
            {%- set type2Dimension = changeTrackingCount > 0 %}
        {%- endif %}
    {%- else %}
        {%- set type2Dimension = false %}
    {%- endif %}

    {%- set source = sources[0] %}
    {%- set joinclause = source.join %}
    {# The node's own CTEs (source.cteString) already open a WITH clause; the load's CTEs must continue it with a comma, since a second WITH is invalid SQL. #}
    {%- set sourceDataCteOpen = ', ' if (source.cteString | default('', true) | trim | length > 0) else 'WITH ' %}

    {# Target path and one load timestamp. In an INSERT ... SELECT each now64(6) reads the clock separately (microseconds apart,
       so an expired SCD2 version could end after its successor starts); a scalar subquery is evaluated once per query #}
    {%- set targetPath = ref_no_link(node.location.name, node.name) %}
    {%- set loadTimestamp = '(SELECT now64(6))' %}

    {# The load's reads of the target, without the FINAL keyword: on a ReplacingMergeTree the statement's
       SETTINGS final = 1 (readWithFinal = true) covers them too; with the parameter false, FINAL is
       expected from the ClickHouse user / session settings #}
    {%- set targetRead = targetPath %}

    {# Zero key records are kept out of change detection: their business key (e.g. 0) can equal a real key, which would
       otherwise match them and overwrite them with that row's data. Every zero record has the zero-record
       SYSTEM_CREATE_DATE (ch_zero_record_date(): epoch 0), so a zero record left from an earlier @zeroKey value — or
       after @zeroKey was removed — stays out too; the current one is also matched by its surrogate value. #}
    {%- set zeroCreateDateCol = columns | selectattr("isSystemCreateDate") | first %}
    {%- set excludeZeroRecord = hasSurrogateKey and (config.zeroKey is defined or zeroCreateDateCol is defined) %}
    {%- if excludeZeroRecord %}
        {%- set notZeroRecord %}
            {%- set nsNotZero = namespace(parts=[]) %}
            {%- if zeroCreateDateCol is defined %}
                {%- set nsNotZero.parts = nsNotZero.parts + ['ifNull(`' ~ zeroCreateDateCol.name ~ '` != ' ~ ch_zero_record_date(zeroCreateDateCol) ~ ', 1)'] %}
            {%- endif %}
            {%- if config.zeroKey is defined %}
                {%- for col in columns if col.isSurrogateKey %}
                    {%- set nsNotZero.parts = nsNotZero.parts + ['`' ~ col.name ~ '` != ' ~ zero_key_surrogate_value(col)] %}
                {%- endfor %}
            {%- endif %}
            {{- nsNotZero.parts | join(' AND ') }}
        {%- endset %}
    {%- endif %}

    {%- if lastModifiedComparison %}
        {# Test stage for checking NULL values in source - last modified column (any datatype: a NULL date/time or numeric value can never compare as newer, so the row would never be picked up as changed) #}
        {{ test_stage('Check Last Modified Column - NULL Values (' ~ lastModifiedColName ~ ')', false) }}
        /* If NULL values are detected, this stage will fail and execution will be terminated */
        {%- set ns = namespace(first=true) %}
        {%- for col in source.columns if col.name == lastModifiedColName %}
            {%- set col_transform = get_source_transform(col) %}
            {%- if col_transform is not none and col_transform != 'NULL' %}
                {{- source.cteString }}
                SELECT 1
                FROM (
                    SELECT {{ get_source_transform(col) }} AS `CHECK_COL`
                    {{ source.join }}
                ) `T`
                WHERE `T`.`CHECK_COL` IS NULL
                {{- source_final_setting(sources, joinAtEnd=false) }}
            {%- endif %}
        {%- endfor %}
    {%- endif %}

    {#== Pre-SQL ==#}
    {{ run_pre_post_sql('Pre') }}

    {# == Determine write mode: truncateInsert or append(default) == #}
    {%- if config.writeMode is defined and config.writeMode.parameters is defined and config.writeMode.parameters | length > 0 %}
        {%- set writeMode = config.writeMode.parameters[0] | trim %}
    {%- else %}
        {%- set writeMode = 'append' %}
    {%- endif %}

	{# == Truncate data before data insertion  == #}
    {%- if writeMode | lower != "append" -%}
        {{ stage('Truncate ' + materializationType) }}
        TRUNCATE IF EXISTS {{ targetPath }}
    {%- endif %}

    {%- if config.zeroKey is defined and hasSurrogateKey %}
        {#- Columns compared with the stored zero record: all but the surrogate key (the lookup key) and the
            update date (the load time). The create date is the zero-record marker, so a zero record written
            before the marker existed is refreshed once. Types ClickHouse cannot compare are skipped. #}
        {%- set nsZeroCmp = namespace(cols=[]) %}
        {%- for col in columns if not (col.isSurrogateKey or col.isSystemUpdateDate) %}
            {%- set zeroFamily = (col.dataType | default('', true) | lower | replace('nullable(', '') | replace('lowcardinality(', '')).split('(')[0] | trim %}
            {%- if zeroFamily not in ['map', 'json', 'object', 'dynamic', 'variant', 'aggregatefunction', 'simpleaggregatefunction'] %}
                {%- set nsZeroCmp.cols = nsZeroCmp.cols + [col] %}
            {%- endif %}
        {%- endfor %}
        {{ stage('Load ' + materializationType + ' - Zero Key Record') }}
            {# Inserted only when there is no zero record with the current surrogate value yet, or its values differ
               from the @zeroKey values: an unchanged run writes nothing. SYSTEM_CREATE_DATE is the zero-record
               marker (ch_zero_record_date()); a refreshed record's newer SYSTEM_UPDATE_DATE replaces the old copy.
               The zero record is version 1, like a real row: its business key values must differ from every real
               business key (column-level @zeroKey), or the two would be one table key. A zero record with a new
               surrogate value replaces the previous one (same business key and version).
               Each @zeroKey value is cast to the column's table type before the comparison, so 'UNKNOWN'
               equals the stored FixedString value. #}
            {#- One value per column, built once: the inserted row and the existence check use the same expressions #}
            {%- set nsZeroVal = namespace(items=[]) %}
            {%- for col in source.columns %}
                {%- set zeroValue %}
                    {%- if col.isSurrogateKey %}{{ zero_key_surrogate_value(col) }}
                    {%- elif col.isSystemCurrentFlag %}'Y'
                    {%- elif col.isSystemEndDate %}{{ ch_high_date(col) }}
                    {%- elif col.isSystemCreateDate %}{{ ch_zero_record_date(col) }}
                    {%- elif col.isSystemUpdateDate %}{{ loadTimestamp }}
                    {%- elif col.isSystemVersion %}1
                    {%- else %}{{ resolve_zero_key(col) }}
                    {%- endif %}
                {%- endset %}
                {%- set nsZeroVal.items = nsZeroVal.items + [{'name': col.name, 'value': zeroValue | trim}] %}
            {%- endfor %}
            INSERT INTO {{ targetPath }}
            (
                {%- for col in columns %}
                    `{{ col.name }}`
                    {%- if not loop.last %}, {%- endif %}
                {%- endfor %}
            )
            SELECT
            {%- for col in columns %}
                {%- for zv in nsZeroVal.items if zv.name == col.name %}
                {{ zv.value }} AS `{{ col.name }}`
                {%- endfor %}
                {%- if not loop.last %}, {%- endif %}
            {%- endfor %}
            {# Skipped when an identical zero record (same surrogate value and values) is already stored #}
            WHERE NOT EXISTS (
                SELECT 1
                FROM {{ targetRead }}
                WHERE
                {%- for col in columns if col.isSurrogateKey %}
                    {%- if not loop.first %} AND {%- endif %}
                    `{{ col.name }}` = {{ zero_key_surrogate_value(col) }}
                {%- endfor %}
                {%- for col in nsZeroCmp.cols %}
                    {%- for zv in nsZeroVal.items if zv.name == col.name %}
                  AND isNotDistinctFrom(`{{ col.name }}`, CAST({{ zv.value }} AS {{ ch_column_type(col) }}))
                    {%- endfor %}
                {%- endfor %}
            )
            {{- target_final_setting() }}
    {%- endif %}

    {%- if lastModifiedComparison %}
        {#== Last Modified SCD ==#}
        {%- if type2Dimension %}
            {{ stage('Load ' + materializationType + ' - Last Modified Comparison - SCD2') }}
        {%- else %}
            {{ stage('Load ' + materializationType + ' - Last Modified Comparison - SCD1') }}
        {%- endif %}
    {%- else %}
        {#== Change Tracking SCD ==#}
        {%- if type2Dimension %}
            {{ stage('Load ' + materializationType + ' - Change Tracking - SCD2') }}
        {%- else %}
            {{ stage('Load ' + materializationType + ' - Change Tracking - SCD1') }}
        {%- endif %}
    {%- endif %}

    INSERT INTO {{ targetPath }}
    (
        {%- for col in columns %}
            `{{ col.name }}`
            {%- if not loop.last %}, {%- endif %}
        {%- endfor %}
    )
        {{- source.cteString }}
        {%- if type2Dimension -%}
            {# SCD Type 2: classifies each source row as NEW/CHANGED/NOCHANGE, then unions the three row shapes (new key, new version, expire old version). #}
            {%- set sysVersionCol = get_value_by_column_attribute("isSystemVersion") %}
            {%- set sysCurrentFlagCol = get_value_by_column_attribute("isSystemCurrentFlag") %}
            {%- set sysCreateDateCol = get_value_by_column_attribute("isSystemCreateDate") %}
            {%- set sysUpdateDateCol = get_value_by_column_attribute("isSystemUpdateDate") %}
            {%- set sysEndDateCol = get_value_by_column_attribute("isSystemEndDate") %}

            {{ sourceDataCteOpen }}`SOURCE_ROWS` AS (
                /* Incoming source rows, transformed and aliased to the target column names */
                SELECT {{ source.selectModifier | default('', true) }}
                {%- for col in source.columns if not (col.isSurrogateKey or col.isSystemVersion or col.isSystemCurrentFlag or col.isSystemCreateDate or col.isSystemUpdateDate or col.isSystemEndDate) %}
                    {{ get_source_transform(col) }} AS `{{ col.name }}`
                    {%- if not loop.last %}, {%- endif %}
                {%- endfor %}
                {%- for col in source.columns if col.isSurrogateKey %},
                    {{ get_source_transform(col) }} AS `SRC_{{ col.name }}`
                {%- endfor %}
                {{ joinclause }}
            ),

{{ source_one_per_key(columns | selectattr('isBusinessKey') | map(attribute='name') | list, lastModifiedColName if lastModifiedComparison else '') }}

            `TARGET_CURRENT` AS (
                /* Only the current (SYSTEM_CURRENT_FLAG = 'Y') version of each business key —
                   history rows are irrelevant for change detection */
                SELECT
                    1 AS `TGT_ROW_EXISTS`,
                {%- for col in columns %}
                    {%- if col.isSurrogateKey %}
                    `{{ col.name }}` AS `TGT_{{ col.name }}`
                    {%- elif col.isBusinessKey or col.isSystemVersion or col.isSystemCurrentFlag or col.isSystemCreateDate or col.isSystemUpdateDate or col.isSystemEndDate %}
                    `{{ col.name }}`
                    {%- else %}
                    `{{ col.name }}` AS `TGT_{{ col.name }}`
                    {%- endif %}
                    {%- if not loop.last %}, {%- endif %}
                {%- endfor %}
                FROM {{ targetRead }}
                WHERE `{{ sysCurrentFlagCol }}` = 'Y'
                {%- if excludeZeroRecord %}
                  AND {{ notZeroRecord }}
                {%- endif %}
            ),

            `CHANGE_DETECTION` AS (
                /* Classify each source row as NEW / CHANGED / NOCHANGE / UPDATE_NON_TYPE2 against
                   the current target row */
                SELECT
                    `SOURCE_DATA`.*,
                    `TARGET_CURRENT`.`{{ sysVersionCol }}` AS `{{ sysVersionCol }}`,
                    `TARGET_CURRENT`.`{{ sysCreateDateCol }}` AS `{{ sysCreateDateCol }}`,
                    `TARGET_CURRENT`.`{{ sysUpdateDateCol }}` AS `{{ sysUpdateDateCol }}`,
                    {%- for col in columns if not (col.isBusinessKey or col.isSystemVersion or col.isSystemCurrentFlag or col.isSystemCreateDate or col.isSystemUpdateDate or col.isSystemEndDate) %}
                    `TARGET_CURRENT`.`TGT_{{ col.name }}` AS `TGT_{{ col.name }}`,
                    {%- endfor %}
                    CASE
                        -- No matching business key in the target at all — this is a brand-new dimension member
                        WHEN ifNull(`TARGET_CURRENT`.`TGT_ROW_EXISTS`, 0) = 0 THEN 'NEW'
                        {%- if lastModifiedComparison %}
                        -- Last-modified-driven: a newer source timestamp than the current target row means a change
                        WHEN `SOURCE_DATA`.`{{ lastModifiedColName }}` > `TARGET_CURRENT`.`TGT_{{ lastModifiedColName }}` THEN 'CHANGED'
                        {%- else %}
                        -- Change-tracking-driven: any @isChangeTracking column differing means a change
                        WHEN (
                            {%- for col in columns if col.isChangeTracking %}
                            {%- if not loop.first %} OR {%- endif %}
                            {{ safe_compare('`SOURCE_DATA`.`' ~ col.name ~ '`', '`TARGET_CURRENT`.`TGT_' ~ col.name ~ '`', col.dataType) }}
                            {%- endfor %}
                        ) THEN 'CHANGED'
                        {%- set nonType2AttrCount = columns | rejectattr("isBusinessKey") | rejectattr("isSurrogateKey") | rejectattr("isSystemVersion") | rejectattr("isSystemCurrentFlag") | rejectattr("isSystemCreateDate") | rejectattr("isSystemUpdateDate") | rejectattr("isSystemEndDate") | rejectattr("isChangeTracking") | list | length %}
                        {%- if nonType2AttrCount > 0 %}
                        -- A plain (non-@isChangeTracking) attribute column differing does NOT trigger
                        -- a new version — it's updated in place on the current row instead.
                        WHEN (
                            {%- for col in columns if not (col.isBusinessKey or col.isSurrogateKey or col.isSystemVersion or col.isSystemCurrentFlag or col.isSystemCreateDate or col.isSystemUpdateDate or col.isSystemEndDate or col.isChangeTracking) %}
                            {%- if not loop.first %} OR {%- endif %}
                            {{ safe_compare('`SOURCE_DATA`.`' ~ col.name ~ '`', '`TARGET_CURRENT`.`TGT_' ~ col.name ~ '`', col.dataType) }}
                            {%- endfor %}
                        ) THEN 'UPDATE_NON_TYPE2'
                        {%- endif %}
                        {%- endif %}
                        ELSE 'NOCHANGE'
                    END AS `CHANGE_TYPE`
                FROM `SOURCE_DATA`
                LEFT JOIN `TARGET_CURRENT` ON
                {%- for col in columns if col.isBusinessKey %}
                    {%- if not loop.first %} AND {%- endif %}
                    {{ safe_equals('`SOURCE_DATA`.`' ~ col.name ~ '`', '`TARGET_CURRENT`.`' ~ col.name ~ '`', col.dataType) }}
                {%- endfor %}
            ),

            `MERGE_ROWS` AS (
                /* Union of the three (or four) SCD2 row shapes: a fresh insert for a brand-new key,
                   a new current version for a changed key, the prior version expired, and — when
                   applicable — an in-place update for a changed plain attribute that doesn't warrant
                   a new version. Expire and in-place update re-insert an existing (key, version) with a
                   newer SYSTEM_UPDATE_DATE, which replaces the old row. */

                /* New business keys not yet present in the target */
                SELECT
                {%- for col in columns %}
                    {%- if col.isSurrogateKey %}
                    {{ new_surrogate_key(col) }}
                    {%- elif col.isSystemVersion %}
                    1
                    {%- elif col.isSystemCurrentFlag %}
                    'Y'
                    {%- elif col.isSystemCreateDate or col.isSystemUpdateDate %}
                    {{ loadTimestamp }}
                    {%- elif col.isSystemEndDate %}
                    {{ ch_high_date(col) }}
                    {%- else %}
                    `{{ col.name }}`
                    {%- endif %}
                    AS `{{ 'TGT_' if col.isSurrogateKey else '' }}{{ col.name }}`,
                {%- endfor %}
                'INSERT_NEW_ROWS' AS `DML_OPERATION`
                FROM `CHANGE_DETECTION`
                WHERE `CHANGE_TYPE` = 'NEW'

                UNION ALL

                /* New current version for rows with a detected change */
                SELECT
                {%- for col in columns %}
                    {%- if col.isSurrogateKey %}
                    {{ new_surrogate_key(col) }}
                    {%- elif col.isSystemVersion %}
                    `{{ col.name }}` + 1
                    {%- elif col.isSystemCurrentFlag %}
                    'Y'
                    {%- elif col.isSystemCreateDate or col.isSystemUpdateDate %}
                    {{ loadTimestamp }}
                    {%- elif col.isSystemEndDate %}
                    {{ ch_high_date(col) }}
                    {%- else %}
                    `{{ col.name }}`
                    {%- endif %}
                    AS `{{ 'TGT_' if col.isSurrogateKey else '' }}{{ col.name }}`,
                {%- endfor %}
                'INSERT_NEW_SCD2_ROWS' AS `DML_OPERATION`
                FROM `CHANGE_DETECTION`
                WHERE `CHANGE_TYPE` = 'CHANGED'

                UNION ALL

                /* Expire the prior current version — expiring is an update, so SYSTEM_UPDATE_DATE is stamped with the load time */
                SELECT
                {%- for col in columns %}
                    {%- if col.isSurrogateKey %}
                    `TGT_{{ col.name }}`
                    {%- elif col.isBusinessKey or col.isSystemVersion or col.isSystemCreateDate %}
                    `{{ col.name }}`
                    {%- elif col.isSystemUpdateDate %}
                    {{ loadTimestamp }}
                    {%- elif col.isSystemCurrentFlag %}
                    'N'
                    {%- elif col.isSystemEndDate %}
                    {{ loadTimestamp }} - toIntervalMillisecond(1)
                    {%- else %}
                    `TGT_{{ col.name }}`
                    {%- endif %}
                    AS `{{ 'TGT_' if col.isSurrogateKey else '' }}{{ col.name }}`,
                {%- endfor %}
                'UPDATE_OLD_SCD2_ROWS' AS `DML_OPERATION`
                FROM `CHANGE_DETECTION`
                WHERE `CHANGE_TYPE` = 'CHANGED'

                {%- if not lastModifiedComparison and nonType2AttrCount > 0 %}
                UNION ALL

                /* Rows whose plain attribute columns changed but no @isChangeTracking column did —
                   updated in place on the current version, no new version is inserted */
                SELECT
                {%- for col in columns %}
                    {%- if col.isSurrogateKey %}
                    `TGT_{{ col.name }}`
                    {%- elif col.isSystemCurrentFlag %}
                    'Y'
                    {%- elif col.isSystemUpdateDate %}
                    {{ loadTimestamp }}
                    {%- elif col.isSystemEndDate %}
                    {{ ch_high_date(col) }}
                    {%- else %}
                    `{{ col.name }}`
                    {%- endif %}
                    AS `{{ 'TGT_' if col.isSurrogateKey else '' }}{{ col.name }}`,
                {%- endfor %}
                'UPDATE_NON_TYPE2_ROWS' AS `DML_OPERATION`
                FROM `CHANGE_DETECTION`
                WHERE `CHANGE_TYPE` = 'UPDATE_NON_TYPE2'
                {%- endif %}
            )
            -- Final SCD2 row set; new rows and new versions get a new surrogate key, re-inserted rows keep theirs
            SELECT
            {%- for col in columns %}
                {%- if col.isSurrogateKey %}
                `TGT_{{ col.name }}`
                {%- else %}
                `{{ col.name }}`
                {%- endif %}
                AS `{{ col.name }}`
                {%- if not loop.last %}, {%- endif %}
            {%- endfor %}
            FROM `MERGE_ROWS`
        {%- else -%}
            {# SCD Type 1: one row per business key, classified NEW/CHANGED/NOCHANGE off the business key (version/current-flag/end-date columns are optional here). #}
            {%- set sysCreateDateCol = get_value_by_column_attribute("isSystemCreateDate") %}
            {# No @isBusinessKey column is already caught by validate_dimension_requirements()'s "Missing Business Key" test above —
               guard here too so a missing key fails that test with a clear message instead of crashing template rendering outright. #}
            {%- set firstBizKeyCol = (columns | selectattr("isBusinessKey") | first).name if hasBusinessKey else none %}

            {{ sourceDataCteOpen }}`SOURCE_ROWS` AS (
                /* Incoming source rows, transformed and aliased to the target column names */
                SELECT {{ source.selectModifier | default('', true) }}
                {%- for col in source.columns if not (col.isSurrogateKey or col.isSystemVersion or col.isSystemCurrentFlag or col.isSystemCreateDate or col.isSystemUpdateDate or col.isSystemEndDate) %}
                    {{ get_source_transform(col) }} AS `{{ col.name }}`
                    {%- if not loop.last %}, {%- endif %}
                {%- endfor %}
                {%- for col in source.columns if col.isSurrogateKey %},
                    {{ get_source_transform(col) }} AS `SRC_{{ col.name }}`
                {%- endfor %}
                {{ joinclause }}
            ),

{{ source_one_per_key(columns | selectattr('isBusinessKey') | map(attribute='name') | list, lastModifiedColName if lastModifiedComparison else '') }}

            `TARGET_CURRENT` AS (
                /* SCD1 = one row per key, so no current-flag filter is needed here. SYSTEM_VERSION,
                   if present at all, rides along but is never used to detect a NEW row. */
                SELECT
                    1 AS `TGT_ROW_EXISTS`,
                {%- for col in columns if not (col.isSystemCurrentFlag or col.isSystemUpdateDate or col.isSystemEndDate) %}
                    {%- if col.isBusinessKey or col.isSystemVersion or col.isSystemCreateDate %}
                    `{{ col.name }}`
                    {%- else %}
                    `{{ col.name }}` AS `TGT_{{ col.name }}`
                    {%- endif %}
                    {%- if not loop.last %}, {%- endif %}
                {%- endfor %}
                FROM {{ targetRead }}
                {%- if excludeZeroRecord %}
                WHERE {{ notZeroRecord }}
                {%- endif %}
            ),

            `CHANGE_DETECTION` AS (
                /* Classify each source row as NEW / CHANGED / NOCHANGE against the current target row */
                SELECT
                    `SOURCE_DATA`.*,
                    {%- for col in columns if col.isSystemVersion %}
                    `TARGET_CURRENT`.`{{ col.name }}` AS `{{ col.name }}`,
                    {%- endfor %}
                    `TARGET_CURRENT`.`{{ sysCreateDateCol }}` AS `{{ sysCreateDateCol }}`,
                    {%- for col in columns if not (col.isBusinessKey or col.isSystemVersion or col.isSystemCurrentFlag or col.isSystemCreateDate or col.isSystemUpdateDate or col.isSystemEndDate) %}
                    `TARGET_CURRENT`.`TGT_{{ col.name }}` AS `TGT_{{ col.name }}`,
                    {%- endfor %}
                    CASE
                        -- NEW is detected off the business key match, not SYSTEM_VERSION — SCD1 works
                        -- the same whether SYSTEM_VERSION exists on this node or not.
                        WHEN ifNull(`TARGET_CURRENT`.`TGT_ROW_EXISTS`, 0) = 0 THEN 'NEW'
                        {%- if lastModifiedComparison %}
                        -- Last-modified-driven: a newer source timestamp than the current target row means a change
                        WHEN `SOURCE_DATA`.`{{ lastModifiedColName }}` > `TARGET_CURRENT`.`TGT_{{ lastModifiedColName }}` THEN 'CHANGED'
                        {%- else %}
                        -- Change-tracking-driven, SCD1: no column can be marked @isChangeTracking here —
                        -- that annotation is exactly what makes a dimension type2 — so SCD1 instead
                        -- compares every plain attribute column for a difference.
                        {%- set scd1AttrCols = columns | rejectattr("isBusinessKey") | rejectattr("isSurrogateKey") | rejectattr("isSystemVersion") | rejectattr("isSystemCurrentFlag") | rejectattr("isSystemCreateDate") | rejectattr("isSystemUpdateDate") | rejectattr("isSystemEndDate") | list %}
                        {%- if scd1AttrCols | length > 0 %}
                        WHEN (
                            {%- for col in scd1AttrCols %}
                            {%- if not loop.first %} OR {%- endif %}
                            {{ safe_compare('`SOURCE_DATA`.`' ~ col.name ~ '`', '`TARGET_CURRENT`.`TGT_' ~ col.name ~ '`', col.dataType) }}
                            {%- endfor %}
                        ) THEN 'CHANGED'
                        {%- else %}
                        -- No plain attribute columns (key-only dimension): an existing key has nothing that can change.
                        {%- endif %}
                        {%- endif %}
                        ELSE 'NOCHANGE'
                    END AS `CHANGE_TYPE`
                FROM `SOURCE_DATA`
                LEFT JOIN `TARGET_CURRENT` ON
                {%- for col in columns if col.isBusinessKey %}
                    {%- if not loop.first %} AND {%- endif %}
                    {{ safe_equals('`SOURCE_DATA`.`' ~ col.name ~ '`', '`TARGET_CURRENT`.`' ~ col.name ~ '`', col.dataType) }}
                {%- endfor %}
            )
            /* Final SCD1 row set: NEW rows are inserted; CHANGED rows are re-inserted with a newer
               SYSTEM_UPDATE_DATE and keep their surrogate key, SYSTEM_VERSION and SYSTEM_CREATE_DATE */
            SELECT
            {%- for col in columns %}
                {%- if col.isSurrogateKey %}
                if(`CHANGE_TYPE` = 'NEW', {{ new_surrogate_key(col) }}, `TGT_{{ col.name }}`)
                {%- elif col.isSystemVersion %}
                if(`CHANGE_TYPE` = 'NEW', 1, `{{ col.name }}`)
                {%- elif col.isSystemCurrentFlag %}
                'Y'
                {%- elif col.isSystemCreateDate %}
                if(`CHANGE_TYPE` = 'NEW', {{ loadTimestamp }}, `{{ sysCreateDateCol }}`)
                {%- elif col.isSystemUpdateDate %}
                {{ loadTimestamp }}
                {%- elif col.isSystemEndDate %}
                {{ ch_high_date(col) }}
                {%- else %}
                `{{ col.name }}`
                {%- endif %}
                AS `{{ col.name }}`
                {%- if not loop.last %}, {%- endif %}
            {%- endfor %}
            FROM `CHANGE_DETECTION`
            WHERE `CHANGE_TYPE` IN ('NEW', 'CHANGED')
        {%- endif %}
        {#- An upstream ReplacingMergeTree is read with FINAL (readWithFinal parameter) #}
        {{- source_final_setting(sources, joinAtEnd=false) }}
    {# NEW rows are found with TGT_ROW_EXISTS (0 or NULL when unmatched), not by a target column being NULL, so the
       load works with either join_use_nulls. The node's own SELECT and JOINs run with the user's settings, as in
       Preview, unless the joinUseNulls runtime parameter is true: the load then ends with join_use_nulls = 1 #}

    {# == Update (not on a ReplacingMergeTree, which replaces the copies itself): delete the copies the INSERT
          replaced (and the previous zero key record) — per business key
          (+ SYSTEM_VERSION when the node has it — the same key as a ReplacingMergeTree's ORDER BY) only the row with
          the latest SYSTEM_UPDATE_DATE is kept.
          Only keys with more than one row (this includes the re-inserted zero record) can have replaced copies, so the
          DELETE and its subquery read just those keys. The clean-up reads only the target, never the source: a DELETE
          cannot use the node's own CTEs (ClickHouse resolves a CTE name inside a DELETE as a table) == #}
    {%- set businessKeyCols = columns | selectattr("isBusinessKey") | list %}
    {%- set replaceKeyCols = (businessKeyCols | map(attribute="name") | list)
                             + (columns | selectattr("isSystemVersion") | map(attribute="name") | list) %}
    {%- set updateDateCols = columns | selectattr("isSystemUpdateDate") | map(attribute="name") | list %}
    {%- if businessKeyCols | length > 0 and updateDateCols | length > 0 and not nsNodeVariables.desiredEngineReplacing %}
        {%- set replaceKey = '`' ~ (replaceKeyCols | join('`, `')) ~ '`' %}
        {%- set touchedKeys %}
            ({{ replaceKey }}) IN (
                SELECT {{ replaceKey }}
                FROM {{ targetPath }}
                GROUP BY {{ replaceKey }}
                HAVING count() > 1
            )
        {%- endset %}
        {{ stage('Clean Up Previous Data') }}
        DELETE FROM {{ targetPath }}
        WHERE {{ touchedKeys }}
          AND ({{ replaceKey }}, `{{ updateDateCols[0] }}`) NOT IN (
            SELECT {{ replaceKey }}, max(`{{ updateDateCols[0] }}`)
            FROM {{ targetPath }}
            WHERE {{ touchedKeys }}
            GROUP BY {{ replaceKey }}
        )
        SETTINGS transform_null_in = 1
    {%- endif %}

    {#== @optimize: OPTIMIZE TABLE ... FINAL, after the load and before Post-SQL ==#}
    {{ optimize_table(targetPath) }}

    {#== Post-SQL ==#}
    {{ run_pre_post_sql('Post') }}

{%- elif materializationType == 'view' %}
	{{ stage('Load Skipped for View') }}
	-- The node {{node.name}} is materialized as View. Therefore, a Load operation is not supported.
	SELECT 1 AS INFO_MESSAGE WHERE FALSE
{%- endif %}

{# == To run data quality tests after data insertion == #}
{{ run_tests('After') }}