{% if node.override.create.enabled %}

    {{ node.override.create.script }}

{% elif node.materializationType == 'table' %}

    {{ stage('Create SQL Stage Table') }}
    CREATE OR REPLACE TABLE {{ ref_no_link(node.location.name, node.name) }}
    (
        {% for col in columns %}
            `{{ col.name | escape_identifier }}` {{ col.dataType }}
            {%- if col.defaultValue | length > 0 %} DEFAULT {{ col.defaultValue }}{% endif %}
            {%- if col.description | length > 0 %} COMMENT '{{ col.description | escape }}'{% endif %}
            {%- if not loop.last -%}, {% endif %}
        {% endfor %}
)
    {%- set table_engine = config.tableEngine | default('MergeTree', true) | trim %}
    ENGINE = {{ table_engine }}
    {%- if config.partitionBy | default('', true) | trim | length > 0 %}
    PARTITION BY {{ config.partitionBy }}
    {%- endif %}
    {%- if 'MergeTree' in table_engine %}
    ORDER BY {{ config.orderBy | default('tuple()', true) }}
    {%- endif %}
    {%- if node.description | length > 0 %}
    COMMENT '{{ node.description | escape }}'
    {%- endif %}

{% elif node.materializationType == 'view' %}

    {{ stage('Create SQL Stage View') }}
    CREATE OR REPLACE VIEW {{ ref_no_link(node.location.name, node.name) }}
    (
        {% for col in columns %}
            `{{ col.name | escape_identifier }}`
            {%- if not loop.last -%}, {% endif %}
        {% endfor %}
    )
    AS
    {% for source in sources %}
        {{ source.cteString }}
        SELECT{% if source.selectModifier %} {{ source.selectModifier }}{% endif %}
        {% for col in source.columns %}
            {{ get_source_transform(col) }} AS `{{ col.name | escape_identifier }}`
            {%- if not loop.last -%}, {% endif %}
        {% endfor %}

        {{ source.join }}

        {% if not loop.last %}
            {% if config.insertStrategy in ['UNION', 'UNION ALL'] %}
                {{ 'UNION DISTINCT' if config.insertStrategy == 'UNION' else config.insertStrategy }}
            {% else %}
                UNION DISTINCT
            {% endif %}
        {% endif %}
    {% endfor %}
    {%- if node.description | length > 0 %}
    COMMENT '{{ node.description | escape }}'
    {%- endif %}


{% endif %}
