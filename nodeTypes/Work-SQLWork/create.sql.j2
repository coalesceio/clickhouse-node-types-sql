{# == Node Type Name           : Work  == #}
{# == Node Type Description    : This node creates work table or view  == #}
{#---------------------------------------------------------------------------------------------#}

{#- nsNodeVariables (object paths, metaDataChanged) is created and initialized in the shared macros #}

{#- Desired/current materialization type, normalized ("Table " = "table"), including "transient table".
    Empty string when the state is absent (first deploy has no currentState; delete has no desiredState). #}
{%- set desiredMatType = nsNodeVariables.desiredMatType %}
{%- set currentMatType = nsNodeVariables.currentMatType %}

{%- if desiredState %}

    {# Validate: the materialization type must be table, transient table or view #}
    {{ validate_materialization_type() }}

    {%- if desiredMatType == 'view' %}

        {# Drop the current object if it was another type, or the view was renamed/moved #}
        {{ object_drop_sql() }}

        {# Did the view DDL change? Render the view definition for both states and compare:
           equal output means only metadata (nothing in the DDL) changed #}
        {%- set viewDefinitionChanged = currentState is not defined
                or (currentState != desiredState
                    and view_definition_sql(currentState) != view_definition_sql(desiredState)) %}

        {# CreateSQL for View #}
        {%- if currentState is not defined
                or currentMatType != desiredMatType
                or nsNodeVariables.curObjectNameFullPath != nsNodeVariables.desObjectNameFullPath
                or viewDefinitionChanged %}
            {{ stage('Create ' + desiredMatType) }}
            CREATE OR REPLACE {{ desiredMatType }} {{ nsNodeVariables.desObjectNameFullPath }}
            {{ view_definition_sql(desiredState) }}

        {%- elif currentState != desiredState %}

            {# Definition unchanged: record a metadata-only change #}
            {{ alter_metadata_sql() }}

        {%- endif %}

    {%- elif desiredMatType in ['table', 'transient table']  %}

        {# Drop the current object if it was another type (a table rename/move is cloned to the new path) #}
        {{ object_drop_sql() }}

        {%- if currentState is not defined or currentMatType != desiredMatType %}

            {# CreateSQL for Table. Work is an intermediate stage: plain MergeTree, sorted by @orderBy / @primaryKey (tuple() when neither),
               with @partitionBy and @settings when set. #}
            {# Validate: @primaryKey must be the leading terms of @orderBy #}
            {{ validate_order_by() }}

            {{ stage('Create ' + desiredMatType) }}
            CREATE OR REPLACE TABLE {{ nsNodeVariables.desObjectNameFullPath }}
            {{ ch_table_definition_sql() }}

        {%- elif currentState is defined and currentState != desiredState and currentMatType == desiredMatType %}

            {# Key / settings changes, or a renamed, retyped or dropped key column, cannot be ALTERed in ClickHouse:
               the table is recreated (warning stage + CREATE OR REPLACE, existing data lost) instead of cloned and altered #}
            {{ set_rebuild_reason() }}
            {%- if nsNodeVariables.rebuildReason %}

                {# Validate: @primaryKey must be the leading terms of @orderBy #}
                {{ validate_order_by() }}

                {# Warning: Table Recreated -> Recreate Table (-> Delete Table at the old path when renamed/moved) #}
                {{ rebuild_table_sql() }}

            {%- else %}

                {# Every alter runs on the clone (nsNodeVariables.alterObjectNameFullPath) #}
                {%- set alterSql %}

                    {# Alter Column: data type, nullability, description, default (old column names) #}
                    {{ alter_modify_columns_sql() }}

                    {# Add Column #}
                    {{ alter_add_columns_sql() }}

                    {# Rename Column (matched by id; a column without @id has its name as id, so it is dropped + added instead) #}
                    {{ alter_rename_columns_sql() }}

                    {# Delete Column #}
                    {{ alter_drop_columns_sql() }}

                    {# Edit Table Description #}
                    {{ alter_description_sql() }}

                {%- endset %}

                {# Clone Table -> alters -> Swap Cloned Table (or Rename Table when renamed/moved) -> Delete Table #}
                {{ alter_clone_swap_sql(alterSql) }}

            {%- endif %}

            {# Nothing above altered the table: record a metadata-only change #}
            {{ alter_metadata_sql() }}
        {%- endif %}
    {%- endif %}
{%- elif currentState is defined and desiredState is not defined %}

    {# Node deleted: drop the current object #}
    {{ object_drop_sql() }}

{%- endif %}
