{% if node.override.create.enabled %}

    {{ node.override.create.script }}

{% else %}
    {{ stage('Create View') }}
    CREATE OR REPLACE VIEW {{ ref_no_link(node.location.name, node.name) }}
    (
        {% for col in columns %}
            `{{ col.name | escape_identifier }}`
            {%- if not loop.last -%}, {% endif %}
        {% endfor %}
    )
    AS
    {% for source in sources %}
        {{ source.cteString }}
        SELECT{% if source.selectModifier %} {{ source.selectModifier }} {% elif config.selectDistinct %} DISTINCT {% endif %}
        {% for col in source.columns %}
            {{ get_source_transform(col) }} AS `{{ col.name | escape_identifier }}`
            {%- if not loop.last -%}, {% endif %}
        {% endfor %}

        {{ source.join }}

        {% if not loop.last %}
            {% if config.insertStrategy in ['UNION', 'UNION ALL'] %}
                {{ 'UNION DISTINCT' if config.insertStrategy == 'UNION' else config.insertStrategy }}
            {% else %}
                UNION DISTINCT
            {% endif %}
        {% endif %}
    {% endfor %}
    {%- if node.description | length > 0 %}
    COMMENT '{{ node.description | escape }}'
    {%- endif %}

{% endif %}
