          "queryResults": [
            {
              "sql": "\n        CREATE OR REPLACE VIEW `WORKSPACE_ANANDHI_TST_DEPLOY`.`AN_WRK_CUSTOMER`\n        (\n            `c_custkey` UInt32 COMMENT 'Customer business key',\n            `customer_name` String COMMENT 'Customer name',\n            `address` String COMMENT 'Customer address',\n            `nation_key` UInt32 COMMENT 'Nation key (TPC-H 0-24)',\n            `phone` String COMMENT 'Phone number',\n            `account_balance` Decimal(12, 2) COMMENT 'Account balance',\n            `market_segment` String COMMENT 'Market segment',\n            `comment` String COMMENT 'Customer comment'\n    )\n    COMMENT 'AN pipeline - Work view: customer with FixedString padding removed and text trimmed'\n    AS\n    \n    SELECT \n        `c`.`c_custkey` AS `c_custkey`,\n        trimBoth(`c`.`c_name`) AS `customer_name`,\n        trimBoth(`c`.`c_address`) AS `address`,\n        `c`.`c_nationkey` AS `nation_key`,\n        trimBoth(toStringCutToZero(`c`.`c_phone`)) AS `phone`,\n        `c`.`c_acctbal` AS `account_balance`,\n        trimBoth(toStringCutToZero(`c`.`c_mktsegment`)) AS `market_segment`,\n        `c`.`c_comment` AS `comment`\n    FROM `WORKSPACE_ANANDHI`.`customer` `c`\n    SETTINGS max_threads = 3, final = 1\n\n",
